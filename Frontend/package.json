{
  "name": "innoclinic-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "preview": "vite preview",
    "format:check": "prettier --check --end-of-line lf \"src/**/*.{ts,tsx,css,html}\"",
    "format:fix": "prettier --write --end-of-line lf \"src/**/*.{ts,tsx,css,html}\"",
    "audit": "npm audit --audit-level=high --omit=dev",
    "prepare": "cd .. && husky Frontend/.husky"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "axios": "^1.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "steiger": "^0.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --end-of-line lf"
    ],
    "src/**/*.{css,html}": [
      "prettier --write --end-of-line lf"
    ]
  },
  "overrides": {
    "handlebars": "4.7.10"
  }
}
